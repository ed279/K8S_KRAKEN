[Unit]
Description=Kraken Bot v12 Paper (Real Price Validation)
After=network.target

[Service]
Type=simple
User=claude
WorkingDirectory=/home/claude/kraken-bot
ExecStart=/usr/bin/python3 /home/claude/kraken-bot/v12/kraken_bot_v12.py --tier paper --mode trading
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
