[Unit]
Description=Kraken Bot v12 Shadow Instance 2
After=network.target

[Service]
Type=simple
User=claude
WorkingDirectory=/home/claude/kraken-bot
ExecStart=/usr/bin/python3 /home/claude/kraken-bot/v12/kraken_bot_v12.py --tier shadow --instance-id shadow-2 --mode trading
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
